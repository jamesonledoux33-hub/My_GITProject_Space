import pygame
import pymunk
import pymunk.pygame_util
import math

pygame.init()

WIDTH, HEIGHT = 1000, 800
window = pygame.display.set_mode((WIDTH, HEIGHT))

def calculate_distance(point1, point2):
    return math.sqrt((point2[1] - point1[1]) ** 2 + (point2[0] - point1[0]) ** 2)

def calculate_angle(point1, point2):
    return math.atan2(point2[1] - point1[1], point2[0] - point1[0])

def draw(space, window, draw_options, line):
    window.fill((255, 255, 255))
    if line:
        pygame.draw.line(window, (0, 0, 255), line[0], line[1], 3)
    space.debug_draw(draw_options)
    pygame.display.update()

def create_bounds(space, width, height):
    rects = [
        [(width / 2, height - 10), (width, 20)],
        [(width / 2, 10), (width, 20)],
        [(10, height / 2), (20, height)],
        [(width - 10, height / 2), (20, height)],
    ]

    for pos, size in rects:
        body = pymunk.Body(body_type=pymunk.Body.STATIC)
        body.position = pos
        shape = pymunk.Poly.create_box(body, size)
        shape.elasticity = 0.8
        shape.friction = 0.5
        space.add(body, shape)

def create_structure(space, width, height):
    BROWN = (139, 69, 19, 100)
    rects = [
        [(width / 2, height - 100), (200, 20), BROWN, 5],
        [(width / 2 - 100, height - 150), (20, 100), BROWN, 5],
        [(width / 2 + 100, height - 150), (20, 100), BROWN, 5],
        [(width / 2 - 50, height - 200), (20, 100), BROWN, 5],
        [(width / 2 + 50, height - 200), (20, 100), BROWN, 5],
    ]

    for pos, size, color, mass in rects:
        body = pymunk.Body()
        body.position = pos
        shape = pymunk.Poly.create_box(body, size, radius = 2)
        shape.mass = mass
        shape.color = color
        shape.elasticity = 0.5
        shape.friction = 0.5
        space.add(body, shape)

def create_swing(space):
    BLUE = (0, 0, 255, 100)
    rotation_center_body = pymunk.Body(body_type=pymunk.Body.STATIC)
    rotation_center_body.position = (300, 270)

    body = pymunk.Body()
    body.position = (300, 300)
    line = pymunk.Segment(body, (0, 0), (255, 0), 5)
    circle = pymunk.Circle(body, 20, (0, 0))
    line.friction = 0.5
    circle.friction = 0.5
    line.mass = 5
    circle.mass = 30
    circle.elasticity = 0.95
    rotation_center_joint = pymunk.PinJoint(body, rotation_center_body, (0, 0), (0, 0))
    space.add(circle, line, body, rotation_center_joint)

def create_ball(space, radius, mass, pos):
    body = pymunk.Body(body_type=pymunk.Body.STATIC)
    body.position = pos
    shape = pymunk.Circle(body, radius)
    shape.mass = mass
    shape.color = (255, 0, 0, 100)
    shape.elasticity = 0.8
    shape.friction = 0.5
    space.add(body, shape)
    return shape

def run(window, width, height):
    run = True
    clock = pygame.time.Clock()
    fps = 60
    
    space = pymunk.Space()
    space.gravity = (0, 981)

    
    create_bounds(space, width, height)
    create_structure(space, width, height)
    create_swing(space)

    draw_options = pymunk.pygame_util.DrawOptions(window)

    pressed_pos = None
    ball = None
    
    while run:
        line = None
        if ball and pressed_pos:

            line = [ball.body.position, pygame.mouse.get_pos()]

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                run = False
                break

            if event.type == pygame.MOUSEBUTTONDOWN:
                if not ball:
                    pressed_pos = pygame.mouse.get_pos()
                    ball = create_ball(space, radius=30, mass=1, pos=pressed_pos)
                elif pressed_pos:
                    ball.body.body_type = pymunk.Body.DYNAMIC
                    angle = calculate_angle(*line)
                    force = calculate_distance(*line) * 10
                    fx = math.cos(angle) * force
                    fy = math.sin(angle) * force
                    ball.body.apply_impulse_at_local_point((fx, fy), (0, 0))
                    pressed_pos = None
                else:
                    space.remove(ball, ball.body)
                    ball = None


        draw(space, window, draw_options, line)
        space.step(1/fps)
        clock.tick(fps)
    pygame.quit()

if __name__ == "__main__":
    run(window, WIDTH, HEIGHT)
        